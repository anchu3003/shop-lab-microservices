# ==============================================================================
# .env.example — biến môi trường chung cho ShopLab (Phase 1)
#
# Cách dùng:
#   cp .env.example .env      # rồi sửa giá trị cho máy mình
#   (file `.env` đã nằm trong .gitignore — KHÔNG commit)
#
# Quy tắc: 12-factor — config đọc từ env (AGENTS.md §6).
#         TUYỆT ĐỐI không đặt secret thật ở đây; chỉ placeholder.
#         Port/database đã chốt ở SL-0.3 (xem infra/docker-compose.yml + README.md).
#
# Lưu ý: `docker compose` nạp `.env` theo *project directory* (thư mục chứa compose
#         file = `infra/`), nên khi chạy phải trỏ tường minh:
#           docker compose -f infra/docker-compose.yml --env-file .env up -d
# ==============================================================================

# --- Môi trường ---
APP_ENV=local
LOG_LEVEL=debug

# --- PostgreSQL (1 instance, nhiều database — database per service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change_me
# DB "main" của instance (nơi init script kết nối vào để tạo các DB còn lại).
POSTGRES_DB=shoplab
POSTGRES_DB_IDENTITY=identity
POSTGRES_DB_CATALOG=catalog
POSTGRES_DB_INVENTORY=inventory
POSTGRES_DB_PROMOTION=promotion
POSTGRES_DB_ORDER=order
POSTGRES_DB_PAYMENT=payment
POSTGRES_DB_NOTIFICATION=notification

# --- Adminer (UI xem dữ liệu Postgres) ---
ADMINER_PORT=8085

# --- Redis (cache / lock / rate limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# --- Message broker (SL-0.1 chốt: RabbitMQ cho Phase 3) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=shoplab
RABBITMQ_PASSWORD=change_me

# --- Service ports (Phase 1) ---
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082

# --- Service template (SL-0.4) ---
# Port của service-template. 8080–8082 đã dành cho api-gateway/identity/catalog ở Phase 1.
SERVICE_TEMPLATE_PORT=8090
# Endpoint /debug/* (slow, error, boom) — chỉ dùng để verify hạ tầng, chỉ bật ở local.
SHOPLAB_DEBUG_ENDPOINTS=true
# Git sha hiển thị ở GET /version. Truyền lúc build image:
#   GIT_COMMIT=$(git rev-parse --short HEAD) docker compose ... up -d --build
GIT_COMMIT=unknown

# --- identity-service (SL-1.1) ---
# Port của identity-service (8080 để dành cho api-gateway, 8082 cho catalog).
IDENTITY_SERVICE_PORT=8081
# `iss` trong JWT. Phải là dạng URI: Spring Security coi `iss` là URL khi verify.
IDENTITY_JWT_ISSUER=https://identity.shoplab.local
# Thời gian sống của access token (15m, 30s, 1h...).
IDENTITY_JWT_ACCESS_TTL=15m
# Grace window cho reuse detection của refresh token (SL-1.18). Mặc định 30s.
# `0s` = tắt: dùng lại token đã rotate là revoke cả chuỗi ngay (strict).
IDENTITY_REFRESH_REUSE_GRACE=30s
# Khoá JWT KHÔNG đặt ở đây: sinh bằng `bash tools/gen-dev-keys.sh` (file bị .gitignore,
# mount read-only vào container). Đường dẫn trong container do compose quy định.
#
# UID/GID để container đọc được private key (mode 600) — lấy bằng `id -u` / `id -g`:
#   bash tools/gen-dev-keys.sh   # script in ra đúng 2 dòng dưới
SHOPLAB_UID=1000
SHOPLAB_GID=1000

# --- api-gateway (SL-1.2) ---
# Cửa vào duy nhất: 8080 dành cho gateway, 8081 identity, 8082 catalog.
API_GATEWAY_PORT=8080
# Base URL của identity-service trong network của compose (gateway route + lấy JWKS từ đây).
IDENTITY_SERVICE_URL=http://identity-service:8081
IDENTITY_SERVICE_HOST=identity-service
# Timeout gọi service đích (bắt buộc có — không timeout thì 1 service treo sẽ kéo sập gateway).
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_READ_TIMEOUT=5s

# --- catalog-service (SL-1.5) ---
# Base URL của catalog-service trong network của compose (route /v1/products + /v1/categories).
CATALOG_SERVICE_URL=http://catalog-service:8082
CATALOG_SERVICE_HOST=catalog-service
# SL-1.15: seed dev (5 category / 20 product / 24 SKU) CHỈ nạp khi chạy local qua compose.
# Image mặc định KHÔNG seed (`classpath:db/migration`); muốn seed thì thêm `,classpath:db/seed`.
# Production/CI: ĐỪNG set biến này (fail-closed).
SHOPLAB_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- Observability (Phase 6 — OpenTelemetry) ---
OTEL_SERVICE_NAMESPACE=shoplab
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
