# ==============================================================================
# .env.example — biến môi trường chung cho ShopLab (Phase 1)
#
# Cách dùng:
#   cp .env.example .env      # rồi sửa giá trị cho máy mình
#   (file `.env` đã nằm trong .gitignore — KHÔNG commit)
#
# Quy tắc: 12-factor — config đọc từ env (AGENTS.md §6).
#         TUYỆT ĐỐI không đặt secret thật ở đây; chỉ placeholder.
#         Port/database đã chốt ở SL-0.3 (xem infra/docker-compose.yml + README.md).
#
# Lưu ý: `docker compose` nạp `.env` theo *project directory* (thư mục chứa compose
#         file = `infra/`), nên khi chạy phải trỏ tường minh:
#           docker compose -f infra/docker-compose.yml --env-file .env up -d
# ==============================================================================

# --- Môi trường ---
APP_ENV=local
LOG_LEVEL=debug

# --- PostgreSQL (1 instance, nhiều database — database per service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change_me
# DB "main" của instance (nơi init script kết nối vào để tạo các DB còn lại).
POSTGRES_DB=shoplab
POSTGRES_DB_IDENTITY=identity
POSTGRES_DB_CATALOG=catalog
POSTGRES_DB_INVENTORY=inventory
POSTGRES_DB_PROMOTION=promotion
POSTGRES_DB_ORDER=order
POSTGRES_DB_PAYMENT=payment
POSTGRES_DB_NOTIFICATION=notification

# --- Adminer (UI xem dữ liệu Postgres) ---
ADMINER_PORT=8085

# --- Redis (cache / lock / rate limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# --- Message broker (SL-0.1 chốt: RabbitMQ cho Phase 3) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=shoplab
RABBITMQ_PASSWORD=change_me

# --- Service ports (Phase 1) ---
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082

# --- Observability (Phase 6 — OpenTelemetry) ---
OTEL_SERVICE_NAMESPACE=shoplab
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
