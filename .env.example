# ==============================================================================
# .env.example — biến môi trường chung cho ShopLab (Phase 1)
#
# Cách dùng:
#   cp .env.example .env      # rồi sửa giá trị cho máy mình
#   (file `.env` đã nằm trong .gitignore — KHÔNG commit)
#
# Quy tắc: 12-factor — config đọc từ env (AGENTS.md §6).
#         TUYỆT ĐỐI không đặt secret thật ở đây; chỉ placeholder.
#         Port/database đã chốt ở SL-0.3 (xem infra/docker-compose.yml + README.md).
#
# Lưu ý: `docker compose` nạp `.env` theo *project directory* (thư mục chứa compose
#         file = `infra/`), nên khi chạy phải trỏ tường minh:
#           docker compose -f infra/docker-compose.yml --env-file .env up -d
# ==============================================================================

# --- Môi trường ---
APP_ENV=local
LOG_LEVEL=debug

# --- PostgreSQL (1 instance, nhiều database — database per service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change_me
# DB "main" của instance (nơi init script kết nối vào để tạo các DB còn lại).
POSTGRES_DB=shoplab
POSTGRES_DB_IDENTITY=identity
POSTGRES_DB_CATALOG=catalog
POSTGRES_DB_INVENTORY=inventory
POSTGRES_DB_PROMOTION=promotion
POSTGRES_DB_ORDER=order
POSTGRES_DB_PAYMENT=payment
POSTGRES_DB_NOTIFICATION=notification

# --- Adminer (UI xem dữ liệu Postgres) ---
ADMINER_PORT=8085

# --- Redis (cache / lock / rate limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# --- Message broker (SL-0.1 chốt: RabbitMQ cho Phase 3) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=shoplab
RABBITMQ_PASSWORD=change_me

# --- Service ports (Phase 1) ---
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
# SL-2.2: inventory-service (reserve/commit/release).
INVENTORY_SERVICE_PORT=8084

# --- Service template (SL-0.4) ---
# Port của service-template. 8080–8082 đã dành cho api-gateway/identity/catalog ở Phase 1.
SERVICE_TEMPLATE_PORT=8090

# --- Inventory (SL-2.2) ---
# Phase 2 chỉ 1 kho; mọi câu SQL đều kèm warehouse_id nên mở multi-warehouse không phải sửa SQL.
INVENTORY_WAREHOUSE_ID=WH-1
# TTL giữ chỗ (ADR-0006 D1). Đổi số này để test hành vi hết hạn mà không phải build lại.
INVENTORY_RESERVATION_TTL=15m
# SL-2.4: promotion-service (voucher).
PROMOTION_SERVICE_PORT=8086
# TTL giữ chỗ 1 lượt voucher — khớp TTL reservation của inventory (15m).
PROMOTION_LOCK_TTL=15m
# Sweeper trả lượt voucher bị bỏ quên.
SHOPLAB_PROMOTION_SWEEP_INTERVAL_MS=60000
SHOPLAB_PROMOTION_SWEEP_INITIAL_DELAY_MS=30000
SHOPLAB_PROMOTION_SWEEP_BATCH_SIZE=100
# SL-2.5: order-service (đơn hàng).
ORDER_SERVICE_PORT=8087
# Giữ response idempotency 24h; row IN_PROGRESS quá 1h coi là mồ côi (job dọn sẽ xoá).
ORDER_IDEMPOTENCY_RETENTION=24h
ORDER_IDEMPOTENCY_STALE_AFTER=1h
ORDER_IDEMPOTENCY_SWEEP_BATCH=200
SHOPLAB_ORDER_SWEEP_INTERVAL_MS=3600000
SHOPLAB_ORDER_SWEEP_INITIAL_DELAY_MS=600000

# --- SL-2.6a: checkout saga (order-service gọi 5 service khác, sync REST) ---
# Compose mặc định dùng hostname nội bộ; override khi chạy service ngoài Docker.
SAGA_CART_URL=http://cart-service:8083
SAGA_CATALOG_URL=http://catalog-service:8082
SAGA_INVENTORY_URL=http://inventory-service:8084
SAGA_PROMOTION_URL=http://promotion-service:8086
SAGA_PAYMENT_URL=http://payment-service:8088
SAGA_CONNECT_TIMEOUT=2s
SAGA_READ_TIMEOUT=800ms
SAGA_CURRENCY=VND
# SL-2.6b: sweeper expire đơn quá hạn thanh toán (15m = TTL reservation/voucher)
SAGA_PAYMENT_WINDOW=15m
SAGA_SWEEP_INTERVAL=60s
SAGA_SWEEP_INITIAL_DELAY=30s
SAGA_SWEEP_BATCH_SIZE=50

# --- SL-2.7: payment-service (payment intent + mock provider + webhook) ---
PAYMENT_SERVICE_PORT=8088

# SL-3.4: notification-service (consumer event đơn hàng).
NOTIFICATION_SERVICE_PORT=8089
NOTIFICATION_SERVICE_URL=http://notification-service:8089

# SL-3.6: search-service (index từ event product + Postgres FTS). 8090 thuộc service-template.
SEARCH_SERVICE_PORT=8091
SEARCH_SERVICE_URL=http://search-service:8091
# Chu kỳ job so số row index vs catalog (log WARN khi lệch > ngưỡng dưới).
SHOPLAB_SEARCH_DRIFT_INTERVAL=10m
SHOPLAB_SEARCH_DRIFT_INITIAL_DELAY=60s
SHOPLAB_SEARCH_DRIFT_THRESHOLD=1
SHOPLAB_NOTIFICATION_FAIL_MODE=false

# --- SL-4.0: retention job (trả TD-29 + TD-30) — dọn bảng phụ theo tuổi ---
# Nhịp job dọn dùng CHUNG cho mọi service (job in-process, `fixedDelay`) — không cần set.
SHOPLAB_RETENTION_SWEEP_INTERVAL=1h
SHOPLAB_RETENTION_SWEEP_INITIAL_DELAY=5m
# `outbox` (order/catalog/payment): giữ row SENT bao lâu. Row PENDING KHÔNG BAO GIỜ bị xoá
# (đó là event chưa gửi — xoá là mất event thật).
SHOPLAB_OUTBOX_RETENTION=7d
SHOPLAB_OUTBOX_CLEANUP_BATCH_SIZE=1000
# `processed_events` (dedupe của consumer). BẤT BIẾN: phải >= SHOPLAB_OUTBOX_RETENTION —
# marker dedupe hết hạn trước event thì replay DLQ muộn sẽ xử lý lại (gửi email 2 lần).
SHOPLAB_EVENTS_DEDUP_RETENTION=7d
SHOPLAB_EVENTS_DEDUP_CLEANUP_BATCH_SIZE=1000
# `notification_logs`: dữ liệu NGHIỆP VỤ (khách còn tra "email tôi nhận hôm đó") ⇒ 90 ngày.
SHOPLAB_NOTIFICATION_LOG_RETENTION=90d
SHOPLAB_NOTIFICATION_CLEANUP_BATCH_SIZE=1000

# --- SL-4.2: cache-aside đường đọc của catalog (ADR-0009) — trả phần cache của TD-22 ---
# Tắt để đo "before" trên CÙNG image: `SHOPLAB_CATALOG_CACHE_ENABLED=false docker compose up -d catalog-service`.
# Redis chết KHÔNG làm catalog lỗi (fail-open): service đọc DB và trả 200, chỉ chậm hơn.
SHOPLAB_CATALOG_CACHE_ENABLED=true
# TTL gốc của detail/list/sku. Jitter ±% để các key không hết hạn cùng lúc (stampede tập thể).
SHOPLAB_CATALOG_CACHE_TTL=60s
SHOPLAB_CATALOG_CACHE_TTL_JITTER_PERCENT=10
# Category gần như không đổi ⇒ TTL dài hơn (ghi vẫn invalidate ngay, TTL dài không làm dữ liệu cũ).
SHOPLAB_CATALOG_CACHE_CATEGORIES_TTL=5m
# Single-flight: lock Redis ngắn + thời gian request thua lock chờ trước khi tự đọc DB.
# Để `lock-wait` quá lớn là tự bắn vào chân: lúc Redis chậm, mọi request ngủ thêm chừng đó.
SHOPLAB_CATALOG_CACHE_LOCK_TTL=2s
SHOPLAB_CATALOG_CACHE_LOCK_WAIT=100ms
# Đổi prefix = "xoá" toàn bộ cache cũ (namespace mới), không cần FLUSHDB.
SHOPLAB_CATALOG_CACHE_KEY_PREFIX=catalog:v1
# Secret HMAC để verify webhook provider — BẮT BUỘC (thiếu ⇒ service chết lúc boot).
# Giá trị này chỉ dùng ở máy dev; môi trường thật set secret thật qua secret manager, KHÔNG commit.
PAYMENT_WEBHOOK_SECRET=dev-only-change-me
# Cửa sổ chống replay theo X-Provider-Timestamp.
PAYMENT_WEBHOOK_TOLERANCE=5m
# Intent sống 15 phút — khớp TTL reservation (inventory) + voucher lock (promotion).
PAYMENT_INTENT_TTL=15m
PAYMENT_PROVIDER=mock
# Trang thanh toán giả (mock provider của chính service, đi qua gateway).
PAYMENT_CHECKOUT_BASE_URL=http://localhost:8080/mock-provider/pay
# Mock provider CHỈ bật ở local: bật ở APP_ENV khác ⇒ service từ chối khởi động (fail-closed).
PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_LATENCY=50ms
PAYMENT_IDEMPOTENCY_RETENTION=24h
PAYMENT_IDEMPOTENCY_STALE_AFTER=1h
PAYMENT_IDEMPOTENCY_SWEEP_BATCH=200
SHOPLAB_PAYMENT_SWEEP_INTERVAL_MS=3600000
SHOPLAB_PAYMENT_SWEEP_INITIAL_DELAY_MS=600000

# --- SL-2.1: cart-service (giỏ hàng trên Redis) ---
CART_SERVICE_PORT=8083
# TTL 30 ngày (architecture §8.3); làm mới mỗi lần ghi nên giỏ đang dùng không hết hạn.
CART_TTL=30d
# Chặn memory abuse ở endpoint public.
CART_MAX_LINES=50
CART_MAX_QTY=999
# Sweeper dọn reservation quá hạn (SL-2.3). Đặt interval ngắn (vd 2000) để xem job chạy khi demo local.
SHOPLAB_INVENTORY_SWEEP_INTERVAL_MS=60000
SHOPLAB_INVENTORY_SWEEP_INITIAL_DELAY_MS=30000
SHOPLAB_INVENTORY_SWEEP_BATCH_SIZE=100
# Endpoint /debug/* (slow, error, boom) — chỉ dùng để verify hạ tầng, chỉ bật ở local.
SHOPLAB_DEBUG_ENDPOINTS=true
# Git sha hiển thị ở GET /version. Truyền lúc build image:
#   GIT_COMMIT=$(git rev-parse --short HEAD) docker compose ... up -d --build
GIT_COMMIT=unknown

# --- identity-service (SL-1.1) ---
# Port của identity-service (8080 để dành cho api-gateway, 8082 cho catalog).
IDENTITY_SERVICE_PORT=8081
# `iss` trong JWT. Phải là dạng URI: Spring Security coi `iss` là URL khi verify.
IDENTITY_JWT_ISSUER=https://identity.shoplab.local

# --- Service-to-service auth (SL-3.11) ---
# Secret của client `order-service` — order xin service token từ identity để gọi inventory/promotion
# khi auto-confirm đơn (SL-3.5) và khi release (TD-25). Đổi ở đây phải đổi cả 2 phía (identity + order).
ORDER_SERVICE_CLIENT_SECRET=change_me_order_service
# Thời gian sống của service token — ngắn có chủ ý (token máy không có refresh/thu hồi).
SHOPLAB_SERVICE_TOKEN_TTL=5m
# Thời gian sống của access token (15m, 30s, 1h...).
IDENTITY_JWT_ACCESS_TTL=15m
# Grace window cho reuse detection của refresh token (SL-1.18). Mặc định 30s.
# `0s` = tắt: dùng lại token đã rotate là revoke cả chuỗi ngay (strict).
IDENTITY_REFRESH_REUSE_GRACE=30s
# Khoá JWT KHÔNG đặt ở đây: sinh bằng `bash tools/gen-dev-keys.sh` (file bị .gitignore,
# mount read-only vào container). Đường dẫn trong container do compose quy định.
#
# UID/GID để container đọc được private key (mode 600) — lấy bằng `id -u` / `id -g`:
#   bash tools/gen-dev-keys.sh   # script in ra đúng 2 dòng dưới
SHOPLAB_UID=1000
SHOPLAB_GID=1000

# --- api-gateway (SL-1.2) ---
# Cửa vào duy nhất: 8080 dành cho gateway, 8081 identity, 8082 catalog.
API_GATEWAY_PORT=8080
# Base URL của identity-service trong network của compose (gateway route + lấy JWKS từ đây).
IDENTITY_SERVICE_URL=http://identity-service:8081
IDENTITY_SERVICE_HOST=identity-service
# Timeout gọi service đích (bắt buộc có — không timeout thì 1 service treo sẽ kéo sập gateway).
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_READ_TIMEOUT=5s

# --- catalog-service (SL-1.5) ---
# Base URL của catalog-service trong network của compose (route /v1/products + /v1/categories).
CATALOG_SERVICE_URL=http://catalog-service:8082
CATALOG_SERVICE_HOST=catalog-service
# SL-1.15: seed dev (5 category / 20 product / 24 SKU) CHỈ nạp khi chạy local qua compose.
# Image mặc định KHÔNG seed (`classpath:db/migration`); muốn seed thì thêm `,classpath:db/seed`.
# Production/CI: ĐỪNG set biến này (fail-closed).
SHOPLAB_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- Observability (Phase 6 — OpenTelemetry) ---
OTEL_SERVICE_NAMESPACE=shoplab
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
