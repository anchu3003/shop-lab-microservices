<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.shoplab</groupId>
    <artifactId>shoplab-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>shoplab-service-commons</artifactId>
  <packaging>jar</packaging>

  <name>ShopLab :: Service Commons</name>
  <description>
    Shared infrastructure library (SL-0.4): correlation id, JSON logging, unified error
    response, dependency health checks, fail-fast config validation.
    CHỈ chứa hạ tầng dùng chung — KHÔNG domain logic, KHÔNG entity/database (AGENTS.md §6).
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!--
      Web types (Filter, @RestControllerAdvice, ResponseEntity) cần để compile, nhưng
      KHÔNG muốn ép mọi consumer kéo theo Tomcat → optional = true (không transitive).
      Service dùng commons phải tự khai `spring-boot-starter-webmvc`.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      spring-security-core — CHỈ để compile `AccessDeniedApiExceptionHandler` (map lỗi `@PreAuthorize`
      thành 403, SL-2.12). Để **optional** như `webmvc`/`springdoc`: service không dùng security
      (vd `service-template`) KHÔNG bị kéo spring-security, và auto-config tự tắt nhờ
      `@ConditionalOnClass(AccessDeniedException.class)` — xem `AccessDeniedAutoConfiguration`.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      spring-boot-starter-amqp — hạ tầng event Phase 3 (SL-3.1 topology, SL-3.2 envelope/publisher).
      Để **optional** như `webmvc`/`security`/`springdoc`: chỉ service nào thực sự publish/consume mới
      khai (order, payment, catalog, notification, search) ⇒ identity/cart/inventory/promotion/gateway
      KHÔNG bị kéo AMQP client + không cố kết nối broker lúc khởi động.
      Auto-config của commons tự tắt nhờ `@ConditionalOnClass(Declarables.class)`.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      spring-jdbc — CHỈ để compile `JdbcProcessedEventStore` (dedupe theo `processed_events`, SL-3.2).
      Optional như các dependency hạ tầng khác: service nào không có DB (vd cart) không bị kéo JDBC,
      và bean store tự tắt nhờ `@ConditionalOnClass(JdbcTemplate.class)`.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!--
      logstash-logback-encoder: commons ship sẵn `logback-shoplab.xml` (JSON + traceId),
      nên encoder phải có mặt ở runtime của service → để compile scope (transitive).
    -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>

    <!--
      springdoc (OpenAPI) — optional vì commons chỉ dùng để dựng auto-config cho service CÓ khai
      starter springdoc; service không khai thì không kéo dependency này (không phình image).
      Chi tiết: `OpenApiAutoConfiguration`.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!--
            Coverage gate (AC SL-0.4): ≥ 80% LINE cho package config + health của shared lib.
            Chỉ 2 package này — không ép coverage lên toàn bộ shared lib ở Phase 0.
          -->
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/shoplab/commons/config/*</include>
                <include>com/shoplab/commons/health/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
