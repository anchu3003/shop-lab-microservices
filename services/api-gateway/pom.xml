<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.shoplab</groupId>
    <artifactId>shoplab-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>shoplab-api-gateway</artifactId>
  <packaging>jar</packaging>

  <name>ShopLab :: API Gateway</name>
  <description>
    Cửa vào duy nhất của ShopLab (SL-1.2): routing theo path prefix (config, không hard-code) · verify JWT RS256
    bằng public key lấy từ JWKS của identity-service · giữ/propagate correlation id · error response thống nhất.
    KHÔNG sở hữu business data (architecture.md §5) → không có DB, không có Flyway.
  </description>

  <!--
    Vì sao KHÔNG có `spring-boot-starter-data-jpa` / Flyway / Testcontainers-postgres: gateway chỉ là proxy + verify token,
    không có dữ liệu riêng. Thêm DB vào đây là sai ranh giới service (AGENTS.md §6: không share DB, và gateway
    không sở hữu data nào).

    SL-4.3 thêm Redis — nhưng KHÔNG phải để lưu dữ liệu: chỉ để đếm token rate limit dùng chung giữa các instance.
    Đọc kỹ `RateLimitProperties`: Redis chết thì gateway vẫn phục vụ (fail-open), và Redis KHÔNG nằm trong readiness.
  -->
  <dependencies>
    <dependency>
      <groupId>com.shoplab</groupId>
      <artifactId>shoplab-service-commons</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>


    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      JWT/JWS + Nimbus JOSE (kèm theo): dùng để VERIFY chữ ký RS256 và parse JWKS.
      Chọn artifact này (BOM quản lý) thay vì khai `com.nimbusds:nimbus-jose-jwt` trực tiếp vì Nimbus
      không có trong BOM → khai trực tiếp là phải tự đoán/pin version (bài học từ SL-1.1).
      Cố ý KHÔNG kéo `spring-boot-starter-security`: gateway tự viết filter mỏng (xem JwtAuthFilter).
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <!-- OpenAPI (SL-1.8): /v3/api-docs để curl spec của gateway (chỉ bật ở local). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Redis thật cho IT của rate limit: thuật toán token bucket nằm trong Lua — mock Lua là test giả
      (đúng bài học của cart-service). Chỉ cần module core + junit-jupiter, không cần module postgresql.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Không kế thừa spring-boot-starter-parent → phải bind goal tường minh. -->
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
          <!-- Sinh META-INF/build-info.properties → bean BuildProperties cho GET /version. -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Failsafe: integration test (*IT.java) — cần Docker (Testcontainers Redis) nên tách khỏi
        surefire. Bắt buộc khai ở module (parent chỉ để ở pluginManagement), nếu không IT không chạy
        và `mvn verify` vẫn xanh — tức là test "có nhưng không ai chạy".

        `classesDirectory` trỏ về output thường: spring-boot repackage thay jar bằng jar "fat", class
        nằm trong BOOT-INF/classes ⇒ failsafe mặc định sẽ NoClassDefFoundError (bẫy đã gặp ở SL-1.1).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!--
            Coverage gate ≥ 80% LINE cho các package "dễ sai và đắt nếu sai": config (fail-fast),
            health (probe), auth (verify token + JWKS), routing (match + forward).
          -->
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/shoplab/gateway/config/*</include>
                <include>com/shoplab/gateway/health/*</include>
                <include>com/shoplab/gateway/auth/*</include>
                <include>com/shoplab/gateway/routing/*</include>
                <include>com/shoplab/gateway/ratelimit/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
