<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.shoplab</groupId>
  <artifactId>shoplab-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ShopLab :: Parent</name>
  <description>Parent POM — convention build / lint / format cho mọi module Java (SL-0.2, SL-0.4)</description>

  <!--
    Ghi chú:
    - Java 21 + Spring Boot là ngôn ngữ chính (ADR-0001); parent POM này để mọi module
      thừa hưởng cùng một convention format/lint thay vì mỗi module một kiểu.
    - FORMAT  = Spotless + google-java-format  → mvn spotless:apply
    - LINT    = Checkstyle (config/checkstyle/checkstyle.xml)
    - Từ SL-0.4 có <modules>: packages/service-commons + services/service-template.
    - Spring Boot version quản lý tập trung qua BOM (import spring-boot-dependencies).
      KHÔNG dùng spring-boot-starter-parent làm parent vì parent này đang giữ convention riêng.
    - Go chưa cấu hình ở đây (toolchain để Phase 2–3 theo ADR-0001).
  -->

  <modules>
    <module>packages/service-commons</module>
    <module>services/service-template</module>
    <module>services/identity-service</module>
    <module>services/catalog-service</module>
    <module>services/inventory-service</module>
    <module>services/api-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Ngôn ngữ chính (ADR-0001). Version chốt ở SL-0.4. -->
    <spring-boot.version>4.1.2</spring-boot.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <!--
      Surefire PHẢI pin: super-POM của Maven để mặc định một bản rất cũ (2.17) — bản đó KHÔNG hỗ trợ
      JUnit Platform, nên Spring Boot 4 (JUnit 6) sẽ chạy ra "Tests run: 0" mà vẫn BUILD SUCCESS.
      Đây là kiểu lỗi nguy hiểm nhất: xanh nhưng không test gì. Phát hiện ở SL-0.4.
    -->
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    <!--
      Failsafe chạy integration test (*IT.java) ở phase integration-test. Pin cùng dòng version với
      surefire; super-POM mặc định bản rất cũ (2.12) không hỗ trợ JUnit Platform → "Tests run: 0".
    -->
    <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
    <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
    <!--
      springdoc-openapi cho Spring Boot 4: dòng **3.x**. Bảng tương thích chính thức:
      Boot 4.1.x → springdoc 3.1.x–3.2.x (Boot 4.0.x → 3.0.x). Dòng 2.x là cho Boot 3 ⇒ dùng
      2.x với Boot 4 sẽ chết lúc khởi động (NoSuchMethod/NoClassDef).
    -->
    <springdoc.version>3.2.0</springdoc.version>
    <!--
      Checkstyle version PHẢI khai báo tường minh (dependency của plugin), vì plugin
      3.6.0 mặc định kéo checkstyle 9.3 (2022) — khá cũ. Override bằng -Dcheckstyle.version
      trên CLI KHÔNG có tác dụng (Maven resolve dependency của plugin từ POM của plugin).
    -->
    <checkstyle.version>12.3.1</checkstyle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM: quản lý version mọi dependency Spring. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Module nội bộ: dùng ${project.version} để không lệch version giữa các module. -->
      <dependency>
        <groupId>com.shoplab</groupId>
        <artifactId>shoplab-service-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- OpenAPI: quản version tập trung (Boot BOM không quản springdoc). -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-logback-encoder.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>


  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!--
              -parameters BẮT BUỘC với Spring: @RequestParam/@PathVariable/@ConfigurationProperties
              dựa vào tên tham số trong class file. Không có cờ này thì Spring MVC ném
              "Name for argument of type [long] not specified" lúc runtime (không phải lúc compile).
              spring-boot-starter-parent bật sẵn; ta không dùng nó nên phải tự bật. Phát hiện ở SL-0.4.
            -->
            <parameters>true</parameters>
          </configuration>
        </plugin>

        <!--
          spring-boot-maven-plugin: version PHẢI khai báo tường minh vì parent này KHÔNG
          kế thừa từ spring-boot-starter-parent (chỉ import BOM, mà BOM không quản version plugin).
        -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <!--
          Failsafe: integration test (*IT.java). Tách khỏi surefire vì IT cần hạ tầng ngoài
          (Testcontainers → Docker), còn unit test phải chạy được ở mọi nơi.
          `mvn verify -DskipITs` để bỏ qua IT (dùng trong `docker build`, nơi không có Docker socket).
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>

        <!-- JaCoCo: version tập trung; rule coverage khai báo ở từng module cần. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- ============ FORMAT: Spotless + google-java-format ============ -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- ============ LINT: Checkstyle ============ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>config/checkstyle/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
